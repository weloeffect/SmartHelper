# Copy this file to .env and replace the placeholder with your Gemini API key.
# The key is used by the server only; never expose it in browser code.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Gemini model IDs can be changed without editing application code.
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# QwenCloud Realtime uses one speech-to-speech model and a pay-as-you-go API key.
DASHSCOPE_API_KEY=replace_with_your_qwen_api_key
QWEN_REALTIME_VOICE=Tina

# First MVP: local app, no sign-in, public mock documentation only.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_AUTH_REQUIRED=false
PUBLIC_DOCS_ONLY=true
